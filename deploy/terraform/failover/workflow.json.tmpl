{
  "Comment": "One-way AWS to Azure failover. No promotion until EC2 stopped. Permanent incident latch prevents duplicate or automatic failback.",
  "StartAt": "AcquireIncident",
  "TimeoutSeconds": 1500,
  "States": {
    "AcquireIncident": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "acquire",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "DuplicateIncident",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ]
    },
    "DuplicateIncident": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.duplicate",
          "BooleanEquals": true,
          "Next": "DuplicateIgnored"
        }
      ],
      "Default": "ConfirmFailure"
    },
    "DuplicateIgnored": {
      "Type": "Succeed"
    },
    "ConfirmFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "confirm",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "RecheckDelay",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "RecheckDelay": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "ConfirmAgain"
    },
    "ConfirmAgain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "confirm",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "AzurePreflight",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "AzurePreflight": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "preflight",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "PreflightDelay",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ]
    },
    "PreflightDelay": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "PreflightResult"
    },
    "PreflightResult": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "command_status",
          "owner.$": "$$.Execution.Id",
          "command_id.$": "$.command_id",
          "node.$": "$.node",
          "phase.$": "$.phase",
          "polls.$": "$.polls"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "PreflightReady",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "PreflightReady": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ready",
          "BooleanEquals": true,
          "Next": "RequestFence"
        }
      ],
      "Default": "PreflightDelay"
    },
    "RequestFence": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "fence",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "FenceDelay",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ]
    },
    "FenceDelay": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "FenceResult"
    },
    "FenceResult": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "fence_status",
          "owner.$": "$$.Execution.Id",
          "polls.$": "$.polls"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Fenced",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "Fenced": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ready",
          "BooleanEquals": true,
          "Next": "PromoteAzure"
        }
      ],
      "Default": "FenceDelay"
    },
    "PromoteAzure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "promote",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "PromotionDelay",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ]
    },
    "PromotionDelay": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "PromotionResult"
    },
    "PromotionResult": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "command_status",
          "owner.$": "$$.Execution.Id",
          "command_id.$": "$.command_id",
          "node.$": "$.node",
          "phase.$": "$.phase",
          "polls.$": "$.polls"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Promoted",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "Promoted": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ready",
          "BooleanEquals": true,
          "Next": "VerifyWriter"
        }
      ],
      "Default": "PromotionDelay"
    },
    "VerifyWriter": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "verify",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "CompleteIncident",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ]
    },
    "CompleteIncident": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "complete",
          "owner.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "Completed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "StoppedForReview"
        }
      ]
    },
    "Completed": {
      "Type": "Succeed"
    },
    "StoppedForReview": {
      "Type": "Fail",
      "Error": "FailoverStopped",
      "Cause": "Do not release incident latch blindly. Confirm EC2/SSM commands and actual database roles; use recovery runbook."
    }
  }
}
