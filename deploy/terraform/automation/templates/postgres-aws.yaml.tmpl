apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: issues
  labels:
    app.kubernetes.io/managed-by: dcs29-automation
spec:
  accessModes:
  - ReadWriteOnce
  storageClassName: local-path
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: postgres-headless
  namespace: issues
  labels:
    app.kubernetes.io/managed-by: dcs29-automation
spec:
  clusterIP: None
  selector:
    app: postgres
  ports:
  - name: postgres
    port: 5432
    targetPort: 5432
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: issues
  labels:
    app.kubernetes.io/managed-by: dcs29-automation
spec:
  ports:
  - name: postgres
    port: 5432
    targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: issues
  labels:
    app.kubernetes.io/managed-by: dcs29-automation
spec:
  serviceName: postgres-headless
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      terminationGracePeriodSeconds: 60
      initContainers:
      - name: verify-image
        image: __POSTGRES_IMAGE__
        command:
        - bash
        - -ec
        - postgres --version | grep -E '^postgres \(PostgreSQL\) 17\.'; test "$(id
          -u postgres)" = 999
      - name: volume-permissions
        image: __POSTGRES_IMAGE__
        command:
        - bash
        - -ec
        - mkdir -p /var/lib/postgresql/data/pgdata; chown -R 999:999 /var/lib/postgresql/data
        volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
      containers:
      - name: postgres
        image: __POSTGRES_IMAGE__
        args:
        - postgres
        - -c
        - config_file=/etc/postgresql/postgresql.conf
        envFrom:
        - secretRef:
            name: postgres-auth
        env:
        - name: POSTGRES_USER
          value: postgres
        - name: POSTGRES_DB
          value: issues
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
        resources:
          requests:
            cpu: 200m
            memory: 256Mi
          limits:
            cpu: '1'
            memory: 1Gi
        startupProbe:
          exec:
            command:
            - pg_isready
            - -h
            - 127.0.0.1
            - -U
            - postgres
            - -d
            - issues
          periodSeconds: 5
          failureThreshold: 60
        readinessProbe:
          exec:
            command:
            - pg_isready
            - -h
            - 127.0.0.1
            - -U
            - postgres
            - -d
            - issues
          periodSeconds: 5
        volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
        - name: config
          mountPath: /etc/postgresql
          readOnly: true
        - name: config
          mountPath: /docker-entrypoint-initdb.d
          readOnly: true
        - name: repl-pass
          mountPath: /var/lib/postgresql/repl
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: postgres-data
      - name: config
        configMap:
          name: postgres-config
      - name: repl-pass
        emptyDir: {}
