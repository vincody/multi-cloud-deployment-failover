apiVersion: apps/v1
kind: Deployment
metadata:
  name: issues-app
  namespace: issues
spec:
  replicas: 1
  selector:
    matchLabels:
      app: issues-app
  template:
    metadata:
      labels:
        app: issues-app
    spec:
      containers:
      - name: app
        image: __APP_IMAGE__
        ports:
        - name: http
          containerPort: 8080
        env:
        - name: APP_ENV
          value: __SITE__
        - name: APP_REGION
          value: __REGION__
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: issues-db
              key: DATABASE_URL
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi
        livenessProbe:
          httpGet:
            path: /health/live
            port: http
          initialDelaySeconds: 10
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /api/database/status
            port: http
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: issues-app
  namespace: issues
spec:
  selector:
    app: issues-app
  ports:
  - name: http
    port: 80
    targetPort: http
