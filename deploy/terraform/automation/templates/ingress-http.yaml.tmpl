apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: issues-http
  namespace: issues
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
spec:
  ingressClassName: traefik
  rules:
  - http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: issues-app
            port:
              number: 80
