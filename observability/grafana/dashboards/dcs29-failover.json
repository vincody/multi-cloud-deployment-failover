{
  "uid": "dcs29-failover",
  "title": "DCS29 - Failover",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "dcs29"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Writer: 1 = origin đang nhận ghi",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "probe_success{job=\"blackbox_writer\"}",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Origin còn phản hồi (health/live)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "probe_success{job=\"blackbox_https\"}",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Thời gian phản hồi probe (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "probe_duration_seconds{job=\"blackbox_https\"}",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear"
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP status của probe",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "probe_http_status_code{job=\"blackbox_https\"}",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Tỷ lệ probe lỗi (5 phút)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "1 - avg_over_time(probe_success{job=\"blackbox_https\"}[5m])",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear"
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "TLS còn hạn (ngày)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcs29-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dcs29-prometheus"
          },
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox_https\"} - time()) / 86400",
          "legendFormat": "{{target_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear"
          },
          "unit": "d"
        },
        "overrides": []
      }
    }
  ]
}